{
  "name": "org-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Org-inspired plain-text document parser and reference analyzer",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "org-lite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "src/data/entities.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run check:test && node --test --test-isolation=none test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
